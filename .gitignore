# NOTE: .gitignore has NO inline comments — '#' only starts a comment at the
# START of a line. Never put "pattern  # explanation" on one line; git treats
# the whole line as a literal pattern and it silently matches nothing.

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ipynb_checkpoints/

# ---- Poetry: commit poetry.lock; the venv is ignored above ----

# ---- ML artifacts: big, regenerable, or sensitive ----
# artifacts/ holds: data/ (datasets), models/ (checkpoints), outputs/ (logs, predictions)
# All regenerable via training/ scripts or published to the HF Hub — never committed.
artifacts/
wandb/

# ---- Secrets: NEVER commit ----
.env
